# 1) 네이버 지도: 네이버 클라우드 플랫폼 > Maps > Application 의 Client ID (브라우저에 노출되는 공개 키)
NEXT_PUBLIC_NAVER_MAP_KEY_ID=

# 2) 가게 검색: 네이버 클라우드 플랫폼 > NAVER API HUB 앱의 Client ID / Client Secret (서버에서만 사용, 절대 공개 금지)
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=

# (선택) 예전 네이버 개발자센터 검색 API 키가 이미 있다면 위 대신 이것을 써도 돼요 (2027.6.30까지)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 3) (추천) 가게 검색 보강: 카카오 개발자 > 내 애플리케이션 > 앱 키 > REST API 키 (서버에서만 사용)
KAKAO_REST_API_KEY=
